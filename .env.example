# Copy to .env and fill in. .env is gitignored; this template is committed.

# Postgres DSN (local Docker or hosted, e.g. Neon/Supabase). Any Postgres works.
LURIEN_DB=postgres://user:pass@host:5432/dbname?sslmode=require

# Backends chosen when flags are omitted.
LURIEN_STORE=postgres          # memory | postgres
LURIEN_NOTIFY=log              # log | telegram | webhook

# Telegram delivery
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook delivery
WEBHOOK_URL=
